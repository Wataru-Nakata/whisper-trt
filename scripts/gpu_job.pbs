#!/bin/bash
# Run one command on an H200 node with the prebuilt torch/TensorRT env (submit through scripts/qsub_pool.sh).
#   scripts/qsub_pool.sh "CMD=scripts/parity.py --out @" [walltime]
# CMD is a python script (relative to the repo) and its arguments; '@' stands for this job's output dir and
# '~' for a space (qsub -v splits its list at commas and is unreliable with spaces).
# REF_CMD (optional) runs first in the faster-whisper venv (the reference implementation).
# A CMD ending in .sh runs with bash, with $PY (this env's python), $REF_PY (the reference venv's) and $OUT set.
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
CMD="${CMD:-}" REF_CMD="${REF_CMD:-}"
CMD="${CMD//\~/ }" REF_CMD="${REF_CMD//\~/ }"
: "${PBS_JOBID:?run via qsub}"
: "${PBS_LOCALDIR:?run via qsub}"
cd "$PBS_O_WORKDIR"
REPO=$PWD
OUT="$REPO/outputs/job-${PBS_JOBID%%.*}"
mkdir -p "$OUT"
export TMPDIR="$PBS_LOCALDIR/tmp" && mkdir -p "$TMPDIR"
export TRITON_CACHE_DIR="$PBS_LOCALDIR/triton" TORCHINDUCTOR_CACHE_DIR="$PBS_LOCALDIR/inductor"
export WHISPER_TRT_CACHE="${WHISPER_TRT_CACHE:-$REPO/.cache/engines}"
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}" HF_HUB_OFFLINE=1
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=8

# Snapshot the code so edits made while the job is queued/running cannot leak into it.
SNAP="$PBS_LOCALDIR/snap"
mkdir -p "$SNAP" && cp -r src scripts tests "$SNAP/"
git rev-parse --short HEAD > "$OUT/commit.txt" 2>/dev/null || true
git status --short > "$OUT/status.txt" 2>/dev/null || true

nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv -l 5 > "$OUT/nvidia-smi.csv" &
SMI=$!
trap 'kill $SMI 2>/dev/null || true' EXIT

# CTranslate2 finds cuBLAS/cuDNN (CUDA 12) in the venv's nvidia packages through LD_LIBRARY_PATH
REF_VENV=.cache/fw-ref-venv
REF_LIBS=$(ls -d "$REF_VENV"/lib/python3.12/site-packages/nvidia/*/lib | paste -sd:)
REF_PY="env LD_LIBRARY_PATH=$REF_LIBS $REF_VENV/bin/python"
if [ -n "${REF_CMD:-}" ]; then
  echo "=== reference: $REF_CMD"
  # shellcheck disable=SC2086
  (cd "$SNAP" && timeout "${REF_TIMEOUT:-3000}" $REF_PY ${REF_CMD//@/$OUT}) 2>&1 | tee "$OUT/ref.log"
fi

if [ -n "${CMD:-}" ]; then
  # Unpack the prebuilt env onto node-local disk: running torch/TensorRT from Lustre is slow.
  ENV_TAR="${ENV_TAR:-/groups/gai51740/acc12576tt/github.com/owsm_trt/.cache/envs/owsm-env.tar.zst}"
  ZSTD="$(command -v zstd || echo "$HOME/miniconda3/bin/zstd")"
  t0=$SECONDS
  "$ZSTD" -dc -T0 "$ENV_TAR" | tar -xf - -C "$PBS_LOCALDIR"
  echo "unpacked $(basename "$ENV_TAR") in $((SECONDS - t0))s"
  PYARR=(env -u CONDA_PREFIX PYTHONPATH="$SNAP/src:$SNAP:$REPO/.cache/extra-site" "$PBS_LOCALDIR/owsm-env/bin/python3")
  nvidia-smi
  echo "=== $CMD"
  if [[ "$CMD" == *.sh* ]]; then
    export PY="${PYARR[*]}" REF_PY OUT SNAP REPO
    # shellcheck disable=SC2086
    (cd "$SNAP" && timeout "${CMD_TIMEOUT:-3300}" bash ${CMD//@/$OUT}) 2>&1 | tee "$OUT/run.log"
  else
    # shellcheck disable=SC2086
    (cd "$SNAP" && timeout "${CMD_TIMEOUT:-3300}" "${PYARR[@]}" ${CMD//@/$OUT}) 2>&1 | tee "$OUT/run.log"
  fi
fi
